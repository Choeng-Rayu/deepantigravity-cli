# ═══════════════════════════════════════════════════════════════
# deepantigravity — Provider Configuration
# ═══════════════════════════════════════════════════════════════
# Set API_PROVIDER to the provider you want to use.
# Just edit this file and run: ./deepantigravity.sh
# No need for -b flag — it reads from here automatically.
#
# Supported providers:
#   kimi               Kimi Code            (Anthropic-native upstream)
#   nv | nvidia        Nvidia NIM           (OpenAI-compat upstream)
# ═══════════════════════════════════════════════════════════════

API_PROVIDER=kimi
# API_PROVIDER=nvidia

# ───────────────────────────────────────────────────────────────
# Proxy port. Must be 443 because agy connects directly to port 443
# of cloudcode-pa.googleapis.com (it doesn't honor HTTPS_PROXY, so
# we hijack DNS via /etc/hosts and then bind 127.0.0.1:443).
# CAP_NET_BIND_SERVICE is granted to the `node` binary by --setup.
# ───────────────────────────────────────────────────────────────
DEEPANTIGRAVITY_PORT=443

# ───────────────────────────────────────────────────────────────
# Kimi Code  (Anthropic-native upstream — subscription-based)
# URL:  https://api.kimi.com/coding
# Get key from https://www.kimi.com/code/console
# ───────────────────────────────────────────────────────────────
KIMI_API_KEY=sk-your-kimi-key
KIMI_MODEL=kimi-for-coding

# ───────────────────────────────────────────────────────────────
# Nvidia NIM  (OpenAI-compatible upstream — needs translation)
# URL:  https://integrate.api.nvidia.com/v1
# Get key from https://build.nvidia.com
# ───────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_MODEL=openai/gpt-oss-120b
