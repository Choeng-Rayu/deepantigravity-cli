# ╔══════════════════════════════════════════════════════════════╗
# ║  deepantigravity — Configuration                           ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Copy this file to .env and fill in your API key(s).
#   cp .env.example .env
#
# You only need the key for the backend you want to use.

# ── Default backend ──────────────────────────────────────────
# Which backend to use when you run without -b flag.
# Options: kimi, nvidia
API_PROVIDER=kimi

# ── Port (don't change) ─────────────────────────────────────
# Must be 443. agy hardcodes port 443 for its endpoint.
DEEPANTIGRAVITY_PORT=443

# ── Kimi Code ────────────────────────────────────────────────
# Get your key: https://www.kimi.com/code/console
# Cost: subscription-based
KIMI_API_KEY=sk-your-kimi-key
KIMI_MODEL=kimi-for-coding

# ── DeepSeek OAuth Web (chat.deepseek.com) ───────────────────
# Drives the browser chat backend (NOT the paid API). Solves a per-turn
# sha3 proof-of-work. No NATIVE tool-calling, but the proxy EMULATES tools
# via prompt markers, so agentic file edits / terminal DO work (less
# reliably than a native API backend).
# TOKEN:  chat.deepseek.com → F12 → Application → Local Storage →
#         key "userToken" → copy its "value".
# COOKIE: F12 → Network → any api/v0 request → Request Headers → copy the
#         full "cookie:" value (must include ds_session_id + aws-waf-token).
DEEPSEEK_OAUTH_WEB_TOKEN=your-deepseek-userToken-from-localStorage
DEEPSEEK_OAUTH_WEB_MODEL=deepseek-v4-pro
DEEPSEEK_OAUTH_WEB_COOKIE=aws-waf-token=...; ds_session_id=...
# Reasoning ("thinking") mode is ON by default. Set to 0 to disable.
# DEEPSEEK_OAUTH_WEB_THINKING=0
# Optional: models shown in agy's `/model` picker (comma-separated).
# Pick from: deepseek-v4-pro, deepseek-v4-flash, deepseek-chat, deepseek-coder, deepseek-reasoner
# Injected entries advertise DeepSeek V4's full 1M-token context window.
# DEEPSEEK_OAUTH_WEB_MODELS=deepseek-v4-pro,deepseek-v4-flash

# ── Nvidia NIM ───────────────────────────────────────────────
# Get your key: https://build.nvidia.com
# Cost: pay-per-token
# Any model from build.nvidia.com works here.
NVIDIA_API_KEY=nvapi-your-nvidia-key
NVIDIA_MODEL=moonshotai/kimi-k2.6

# Optional: models shown in agy's `/model` picker (comma-separated).
# Pick any from build.nvidia.com. Selecting one in `/model` routes that
# session to that specific model. If unset, a curated default list is used.
# NVIDIA_MODELS=openai/gpt-oss-120b,qwen/qwen3-coder-480b-a35b-instruct,stepfun-ai/step-3.7-flash

# ── Debug (optional) ─────────────────────────────────────────
# Set to 1 to log all request/response bodies to .cache/requests/
# DEEPANTIGRAVITY_DEBUG=1
